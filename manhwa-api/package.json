{
  "name": "manhwa-api",
  "version": "1.0.0",
  "description": "Backend API for Manhwa Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider node src/server.js",
    "dev": "NODE_OPTIONS=--openssl-legacy-provider nodemon --ignore 'data/' src/server.js",
    "test": "jest",
    "verify:top10-country": "node scripts/verify-top10-country.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js"
  },
  "keywords": [
    "manhwa",
    "api",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/lib-storage": "^3.972.0",
    "@marsidev/react-turnstile": "^1.4.2",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "blurhash": "^2.0.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "sharp": "^0.33.5",
    "zod": "^3.25.76",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "xss-clean": "^0.1.4"
