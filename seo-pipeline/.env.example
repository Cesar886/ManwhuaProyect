# ============================================
# IMPERIAL-AGENT v2 — CONFIGURACION
# SEO/GEO Autonomous Agent — Manhwa Imperial
# ============================================

# -- GOOGLE SEARCH CONSOLE --
GOOGLE_CREDENTIALS_PATH=../manhwa-api/src/config/google-indexing-credentials.json
GSC_SITE_URL=https://manhwaimperial.site

# -- BING WEBMASTER TOOLS --
BWT_API_KEY=
BWT_SITE_URL=https://manhwaimperial.site
BWT_COMPETITORS=lectortmo.com,mangatmo.com,inmanga.com,manhuascan.com

# -- INDEXNOW --
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# -- OPENAI API (GPT-4o) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MONTHLY_LIMIT_USD=20
OPENAI_PAUSE_AT_PCT=80

# -- CONTROL DE COSTOS --
# Al 80% del limite -> pausar solo Modulo 6
# Al 95% del limite -> solo Modulos 1, 2, 3 (sin GPT)
# Al 100% del limite -> solo notificar, cero llamadas GPT

# -- BASE DE DATOS (auto-deteccion) --
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=manhwa_imperial
DB_USER=
DB_PASS=

# Para MongoDB (alternativa)
# MONGODB_URI=mongodb://user:pass@localhost:27017/manhwa_imperial

# -- CMS API (alternativa a DB directa) --
CMS_API_BASE=http://localhost:3000/api
CMS_API_KEY=

# -- UMBRAL DE CONFIANZA --
AI_CONFIDENCE_THRESHOLD=0.75

# -- LIMITES POR EJECUCION --
MAX_TITLES_PER_RUN=20
MAX_PAGES_PER_RUN=5
MAX_SCHEMAS_PER_RUN=10
MAX_GEO_PER_RUN=10

# -- NOTIFICACIONES --
NOTIFICATION_EMAIL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

NOTIFY_ON_DRAFT=true

# -- REDES SOCIALES (para schema Organization) --
SITE_SOCIAL_LINKS=

# -- PIPELINE --
MIN_DATA_DAYS=30
REPORTS_DIR=./reports
