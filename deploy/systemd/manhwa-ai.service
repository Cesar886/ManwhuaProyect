[Unit]
Description=Manhwa Imperial AI search service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/manhwa-ai
Environment=NODE_ENV=production
Environment=PORT=3003
EnvironmentFile=-/var/www/manhwa-ai/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
