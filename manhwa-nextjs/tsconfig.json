{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/app/biblioteca/page.jsx",
    "src/app/colecciones/page.jsx",
    "src/app/home/page.jsx",
    "src/app/layout.jsx",
    "src/app/manhwa/[slug]/capitulo/[numero]/page.jsx",
    "src/app/manhwa/[slug]/page.jsx",
    "src/app/page.jsx",
    "src/app/perfil/page.jsx",
    "src/app/populares/page.jsx",
    "src/components/AppLayout.jsx",
    "src/components/Footer.jsx",
    "src/components/Header.jsx",
    "src/components/LoginModal.jsx",
    "src/components/ManhwaCard.jsx",
    "src/components/ManhwaCardSkeleton.jsx",
    "src/components/Toast.jsx",
    "src/contexts/AuthContext.jsx",
    "src/lib/api/client.js",
    "src/lib/api/manhwa.js",
    ".next-cover-final/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
