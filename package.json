        "express-rate-limit": "^7.5.1",
        "fuse.js": "^7.5.0",
        "helmet": "^7.2.0",
        "lru-cache": "^10.4.3",
        "pg": "^8.23.1",
        "pgvector": "^0.2.1",
        "pino": "^9.14.0",
        "react-virtuoso": "^4.18.5",
        "socket.io": "^4.8.4"
